# CognEn v1.0 environment template.
# Copy to .env.local and fill in your own values. PLACEHOLDERS ONLY - never
# commit real values (.env* is gitignored except this file).

# --- Firebase Web SDK client config (public, not secret; see src/lib/firebase.ts) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- Server only ---
# SECRET. Gemini key for the report export (src/ai/genkit.ts). GOOGLE_API_KEY also works.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional: project id used to verify Firebase ID tokens in the report server
# action (src/app/actions.ts). Defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# FIREBASE_PROJECT_ID=your-project-id

# --- DACE research mode (all optional; DACE is off when unset; see README §15) ---
# NEXT_PUBLIC_DACE_PRESET=F
# NEXT_PUBLIC_DACE_ENABLED=false
# NEXT_PUBLIC_DACE_MEASUREMENT=legacy
# NEXT_PUBLIC_DACE_EVIDENCE=false
# NEXT_PUBLIC_DACE_RULES=false
# NEXT_PUBLIC_DACE_ABSTAIN=off
# NEXT_PUBLIC_DACE_DETECTOR=yolo
# NEXT_PUBLIC_DACE_KINEMATICS=off
# NEXT_PUBLIC_DACE_TEMPORAL_MODEL=rules
# NEXT_PUBLIC_DACE_BASELINE=internal
# NEXT_PUBLIC_DACE_LOG=off
# NEXT_PUBLIC_DACE_SHUFFLE_OBJECTS=false
# NEXT_PUBLIC_DACE_RESEARCH=0
# NEXT_PUBLIC_DACE_YOLO_SHA256=
